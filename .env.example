# Value Companion AI Platform
# Environment Variables Template
# Copy to .env and fill in real values (DO NOT COMMIT .env)

# Venice AI Configuration
VENICE_API_KEY=your_venice_api_key_here
VENICE_BASE_URL=https://api.venice.ai/v1
VENICE_MODEL=k2.5

# Database
DATABASE_URL=your_database_url_here
DB_NAME=valuecompanion
DB_USER=vc_admin

# Application
SECRET_KEY=your_secret_key_here
DEBUG=False
ENVIRONMENT=production

# API Configuration
API_BASE_URL=https://api.valuecompanion.ai/v1
CORS_ORIGINS=https://valuecompanion.ai,https://www.valuecompanion.ai

# Analytics (optional)
ANALYTICS_KEY=your_analytics_key

# Email
SMTP_HOST=smtp.example.com
SMTP_USER=noreply@valuecompanion.ai
